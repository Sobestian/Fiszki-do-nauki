        }
      ]
    },
    {
      "id": "card-4d58fcec-bc6e-4a92-a6df-75e5e98eff6f",
      "question": [
        {
          "type": "text",
          "text": "Połączenie równoległe vs szeregowe"
        }
      ],
      "answer": [
        {
          "type": "text",
          "text": "Szeregowe:\n- Napięcie - sumuje się\n- Pojemność - nie zmienia się\n\nRównoległe:\n- Napięcie - nie zmienia się\n- Pojemność - sumuje się"
        },
        {
          "type": "image",
          "src": "../assets/editor/item-bf131b6faa1f/72912a0914f3419cba.png",
          "alt": "rownolegle.png",
          "remove_white_background": false
        }
      ]
    },
    {
      "id": "card-bfffd0bb-0341-4ab3-8a50-b0d8b7c7e451",
      "question": [
        {
          "type": "text",
          "text": "Połączenie równoległe"
        }
      ],
      "answer": [
        {
          "type": "text",
          "text": "- Napięcie - nie zmienia się\n- Pojemność - sumuje się"
        },
        {
          "type": "formula",
          "latex": "\\frac{1}{Rz} = \\frac{1}{R_1} + \\frac{1}{R_2} + \\frac{1}{R_3}"
        },
        {
          "type": "formula",
          "latex": "Rz = \\frac{R_1 \\cdot  R_2}{R_1 + R_2}"
        },
        {
          "type": "image",
          "src": "../assets/editor/item-bf131b6faa1f/1459b5eca1ea43a9a2.png",
          "alt": "rownolegle 2.png",
          "remove_white_background": false
        },
