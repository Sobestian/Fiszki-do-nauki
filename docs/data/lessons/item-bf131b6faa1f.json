    {
      "id": "card-fc6751c6-b0d0-48b7-bf61-315946d2e06a",
      "question": [
        {
          "type": "text",
          "text": "Połączenie szeregowe"
        }
      ],
      "answer": [
        {
          "type": "text",
          "text": "- Napięcie - sumuje się\n- Pojemność - nie zmienia się"
        },
        {
          "type": "formula",
          "latex": "Rz = R_1 + R_2 + R_3"
        },
        {
